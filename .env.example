# MongoDB connection string (Atlas or local)
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/verdant?retryWrites=true&w=majority

# NextAuth configuration
NEXTAUTH_SECRET=verdant-super-secret-auth-key-change-in-production-2024
NEXTAUTH_URL=http://localhost:3000

# Optional Cloudinary configuration for live cloud uploads
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Secret token for Vercel Cron scheduled endpoint
CRON_SECRET=verdant_cron_secret_secure_987654321

# Web Push Notifications (PWA)
NEXT_PUBLIC_VAPID_PUBLIC_KEY=your_public_vapid_key_here
VAPID_PRIVATE_KEY=your_private_vapid_key_here
VAPID_SUBJECT=mailto:support@verdant.com

# PWA Development Mode
NEXT_PUBLIC_PWA_DEV=false

# Auth Demo Credentials (set to "true" to display interactive demo role selectors on login page)
NEXT_PUBLIC_SHOW_DEMO=false
